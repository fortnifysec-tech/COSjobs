{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(~/**)",
      "Read(//etc/**)",
      "Read(//root/**)",
      "Edit(~/**)",
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(docker *)",
      "Bash(git push *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": ["~/.ssh", "~/.aws", "~/.config", "/etc/shadow"]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "api.anthropic.com",
        "registry.npmjs.org",
        "*.github.com",
        "github.com",
        "*.supabase.co",
        "*.pooler.supabase.com",
        "api.stripe.com",
        "api.resend.com",
        "fonts.googleapis.com",
        "fonts.gstatic.com",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com"
      ]
    }
  }
}
