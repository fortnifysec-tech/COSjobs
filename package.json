    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "^6.9.5",
    "resend": "^6.26.0",
    "stripe": "^22.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
